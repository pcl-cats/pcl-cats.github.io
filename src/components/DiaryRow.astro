---
import Icon from './Icon.astro';
import type { Diary } from '../lib/content';
import { dayOfMonth, diaryUrl, excerpt, weekday } from '../lib/content';
import { placeholder, thumb } from '../lib/images';

interface Props {
  entry: Diary;
  /** 日期下方显示星期几，或者“11 月”（不按月分组时用） */
  sub?: 'weekday' | 'month';
}

const { entry, sub = 'weekday' } = Astro.props;
const { date, title, cover, milestone } = entry.data;
const subText = sub === 'weekday' ? weekday(date) : `${Number(date.slice(5, 7))} 月`;
const summary = excerpt(entry.body, 60);
---

<a class:list={['diary-row', milestone && 'is-milestone']} href={diaryUrl(date)}>
  <time class="date" datetime={date}>
    <span class="day">{dayOfMonth(date)}</span>
    <span class="sub">{subText}</span>
  </time>
  <div class="text">
    <h3>
      {milestone && <Icon name="star" size={16} class="star" />}
      {title}
    </h3>
    {summary && summary !== title && <p>{summary}</p>}
  </div>
  {
    cover && (
      <img class="thumb" src={thumb(cover, 200)} alt="" width="160" height="160" loading="lazy" decoding="async" style={`background-color: ${placeholder(cover)}`} />
    )
  }
</a>

<style>
  .diary-row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: start;
    gap: 12px;
    padding: 16px 12px;
    margin-inline: -12px;
    border-radius: var(--radius-sm);
    transition: background 0.2s;
  }

  .diary-row:hover {
    background: var(--card);
  }

  .diary-row:active {
    background: var(--paper-deep);
  }

  .date {
    display: grid;
    justify-items: center;
    padding-top: 1px;
    line-height: 1.1;
  }

  .day {
    font-family: var(--font-hand);
    font-size: 26px;
    color: var(--heading);
  }

  .sub {
    margin-top: 4px;
    font-size: 12px;
    color: var(--text-soft);
    white-space: nowrap;
  }

  h3 {
    font-size: 18px;
    line-height: 1.45;
  }

  h3 :global(.star) {
    display: inline-block;
    vertical-align: -2px;
    margin-right: 4px;
    color: var(--gold);
  }

  p {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .thumb {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    object-fit: cover;
    background: var(--paper-deep);
  }

  @media (min-width: 768px) {
    .diary-row {
      grid-template-columns: 52px minmax(0, 1fr) auto;
      gap: 20px;
      padding: 18px 16px;
      margin-inline: -16px;
    }

    .day {
      font-size: 30px;
    }

    h3 {
      font-size: 20px;
    }

    p {
      font-size: 15px;
    }

    .thumb {
      width: 96px;
      height: 96px;
    }
  }
</style>
