---
import type { Cat } from '../lib/content';
import { catUrl, statusLabel, statusTone } from '../lib/content';
import { placeholder, thumb } from '../lib/images';

interface Props {
  cat: Cat;
  eager?: boolean;
}

const { cat, eager = false } = Astro.props;
const { name, photo, appearance, status } = cat.data;
---

<a class="cat-card" href={catUrl(cat.id)} data-tilt="6">
  <div class="photo">
    <img
      src={thumb(photo, 400)}
      alt={name}
      width="480"
      height="600"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      style={`view-transition-name: cat-${cat.id}; background-color: ${placeholder(photo)}`}
    />
    {status !== '园区活动' && <span class:list={['tag', `tag-${statusTone[status]}`]}>{statusLabel[status]}</span>}
  </div>
  <h3>{name}</h3>
  {appearance && <p>{appearance}</p>}
</a>

<style>
  .cat-card {
    display: block;
    min-width: 0;
  }

  .photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
    background: var(--paper-deep);
    box-shadow: var(--shadow-sm);
    transform: perspective(700px) rotateX(var(--rx, 0)) rotateY(var(--ry, 0));
    transition:
      transform 0.5s var(--ease-out),
      box-shadow 0.3s;
  }

  .cat-card:global(.is-tilting) .photo {
    transition:
      transform 0.1s linear,
      box-shadow 0.3s;
  }

  .cat-card:hover .photo {
    box-shadow: var(--shadow);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tag {
    position: absolute;
    top: 10px;
    left: 10px;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.08);
  }

  h3 {
    margin-top: 10px;
    font-size: 20px;
    line-height: 1.35;
  }

  p {
    font-size: 14px;
    color: var(--text-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cat-card:active .photo {
    transform: scale(0.98);
  }
</style>
