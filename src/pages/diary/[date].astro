---
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import CatAvatar from '../../components/CatAvatar.astro';
import Icon from '../../components/Icon.astro';
import { diaryUrl, excerpt, formatDate, getCats, getDiary, weekday, type Diary } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getDiary();
  return entries.map((entry, index) => ({
    params: { date: entry.data.date },
    // 列表是新的在前：index - 1 是更新的一篇，index + 1 是更早的一篇
    props: { entry, newer: entries[index - 1], older: entries[index + 1] },
  }));
}

const { entry, newer, older } = Astro.props as { entry: Diary; newer?: Diary; older?: Diary };
const { Content } = await render(entry);
const { date, title, milestone, cover } = entry.data;
const cats = await getCats();
const related = (entry.data.cats ?? []).map((id) => cats.find((cat) => cat.id === id)).filter((cat) => cat !== undefined);
---

<SiteLayout title={title} description={excerpt(entry.body, 80) || title} image={cover}>
  <article class="container container-narrow">
    <a class="back" href="/diary/"><Icon name="arrow-left" size={18} /> 日记</a>
    <header>
      <p class="meta">
        <time datetime={date}>{formatDate(date)} · {weekday(date)}</time>
        {
          milestone && (
            <a class="tag tag-gold" href="/diary/?view=milestones">
              <Icon name="star" /> 大事记
            </a>
          )
        }
      </p>
      <h1>{title}</h1>
    </header>
    <div class="prose body"><Content /></div>

    {
      related.length > 0 && (
        <section class="cats" aria-labelledby="cats-title">
          <h2 id="cats-title">这天的猫</h2>
          <div class="cat-list">
            {related.map((cat) => cat && <CatAvatar cat={cat} size={64} />)}
          </div>
        </section>
      )
    }

    <nav class="pager" aria-label="相邻的日记">
      {
        older ? (
          <a href={diaryUrl(older.data.date)}>
            <span><Icon name="arrow-left" size={16} /> 前一篇</span>
            <strong>{older.data.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a class="next" href={diaryUrl(newer.data.date)}>
            <span>后一篇 <Icon name="arrow-right" size={16} /></span>
            <strong>{newer.data.title}</strong>
          </a>
        )
      }
    </nav>
  </article>
</SiteLayout>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 16px 0 8px;
    font-size: 15px;
    color: var(--text-soft);
  }

  .back:hover {
    color: var(--heading);
  }

  header {
    padding: 16px 0 24px;
    border-bottom: 1px solid var(--line);
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    font-size: 15px;
    color: var(--text-soft);
  }

  h1 {
    margin-top: 10px;
    font-size: clamp(30px, 7vw, 44px);
    line-height: 1.3;
  }

  .body {
    padding-top: 24px;
  }

  .cats {
    margin-top: 40px;
    padding: 20px 20px 16px;
    border-radius: var(--radius);
    background: var(--paper-deep);
  }

  .cats h2 {
    font-size: 20px;
    margin-bottom: 14px;
  }

  .cat-list {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 4px;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 40px;
  }

  .pager a {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 16px;
    border-radius: var(--radius-sm);
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow 0.2s;
  }

  .pager a:hover {
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--shadow-sm);
  }

  .pager span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    color: var(--text-soft);
  }

  .pager strong {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.45;
    color: var(--heading);
  }

  .pager .next {
    text-align: right;
    justify-items: end;
  }

  @media (min-width: 768px) {
    header {
      padding-top: 24px;
    }
  }
</style>
