---
import { getEntry, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCats, getDiary } from '../lib/content';

const about = await getEntry('pages', 'about');
const guide = await getEntry('pages', 'guide');
if (!about || !guide) throw new Error('缺少 content/about.md 或 content/guide.md');
const { Content: About } = await render(about);
const { Content: Guide } = await render(guide);

const cats = await getCats();
const diary = await getDiary();
const numbers = [
  { value: cats.length, label: '只猫的档案' },
  { value: cats.filter((cat) => cat.data.status === '已领养').length, label: '只找到了家' },
  { value: diary.length, label: '篇照护日记' },
];
---

<SiteLayout title="关于我们" description="PCL-Cats 是园区里一群喜欢猫的学生和老师，一起照顾园区里的流浪猫。">
  <header class="page-head container head">
    <div>
      <h1>关于我们</h1>
    </div>
    <img src="/art/months/02.webp" alt="" width="640" height="560" data-reveal />
  </header>

  <div class="container container-narrow">
    <ul class="numbers" data-reveal>
      {
        numbers.map((item) => (
          <li>
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </li>
        ))
      }
    </ul>

    <div class="prose"><About /></div>

    <section class="guide" id="guide" aria-labelledby="guide-title" data-reveal>
      <img src="/art/months/03.webp" alt="" width="640" height="640" loading="lazy" />
      <h2 id="guide-title">和猫猫相处</h2>
      <div class="prose"><Guide /></div>
    </section>
  </div>
</SiteLayout>

<style>
  .head {
    display: grid;
    gap: 12px;
    align-items: end;
  }

  .head img {
    width: min(72vw, 300px);
    height: auto;
    justify-self: center;
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0 0 36px;
    padding: 20px 0;
    list-style: none;
    border-block: 1px solid var(--line);
    text-align: center;
  }

  .numbers li + li {
    border-left: 1px solid var(--line);
  }

  .numbers strong {
    display: block;
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: clamp(32px, 8vw, 44px);
    line-height: 1.2;
    color: var(--heading);
  }

  .numbers span {
    font-size: 14px;
    color: var(--text-soft);
  }

  .guide {
    position: relative;
    margin-top: 72px;
    padding: 64px 22px 28px;
    border-radius: 28px;
    background: var(--paper-deep);
  }

  .guide img {
    position: absolute;
    top: -70px;
    right: 8px;
    width: 130px;
    height: auto;
  }

  .guide h2 {
    font-size: clamp(26px, 5vw, 32px);
    margin-bottom: 16px;
  }

  @media (min-width: 768px) {
    .head {
      grid-template-columns: 1fr auto;
      max-width: calc(720px + var(--gutter) * 2);
    }

    .head img {
      width: 280px;
      margin-bottom: -24px;
    }

    .guide {
      padding: 44px 44px 40px;
    }

    .guide img {
      width: 170px;
      top: -90px;
      right: 28px;
    }
  }
</style>
