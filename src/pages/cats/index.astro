---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CatCard from '../../components/CatCard.astro';
import Icon from '../../components/Icon.astro';
import { getCats, statusLabel, type CatStatus } from '../../lib/content';

const cats = await getCats();
const statuses: CatStatus[] = ['园区活动', '已领养', '失踪'];
const countOf = (status: CatStatus) => cats.filter((cat) => cat.data.status === status).length;
---

<SiteLayout title="园区的猫" description="PCL 园区里每一只猫的照片、性格和故事。">
  <header class="page-head container">
    <h1>园区的猫</h1>
    <p>一共 {cats.length} 只。点开照片，看看它们的故事。</p>
  </header>

  <section class="container" aria-label="全部猫猫">
    <div class="toolbar">
      <label class="field">
        <span class="visually-hidden">按名字或花色找猫</span>
        <Icon name="search" />
        <input id="cat-search" type="search" placeholder="名字或花色" autocomplete="off" enterkeyhint="search" />
      </label>
      <div class="chips" role="group" aria-label="按状态筛选">
        <button class="chip" type="button" data-status="" aria-pressed="true">全部 <small>{cats.length}</small></button>
        {
          statuses.map((status) => (
            <button class="chip" type="button" data-status={status} aria-pressed="false">
              {statusLabel[status]} <small>{countOf(status)}</small>
            </button>
          ))
        }
      </div>
    </div>

    <div class="grid">
      {
        cats.map((cat, index) => (
          <div
            class="item"
            data-reveal
            style={`--i: ${index % 4}`}
            data-status={cat.data.status}
            data-search={`${cat.data.name} ${cat.data.appearance ?? ''}`.toLowerCase()}
          >
            <CatCard cat={cat} eager={index < 4} />
          </div>
        ))
      }
    </div>

    <div class="empty" id="cat-empty" hidden>
      <img src="/art/cats/jojo-2.webp" alt="" width="180" height="220" loading="lazy" />
      <p>没有找到这只猫，换个名字试试？</p>
    </div>
  </section>
</SiteLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#cat-search')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const items = [...document.querySelectorAll<HTMLElement>('.item')];
  const empty = document.querySelector<HTMLElement>('#cat-empty')!;
  const params = new URLSearchParams(location.search);
  let status = params.get('status') ?? '';
  search.value = params.get('q') ?? '';

  const update = () => {
    const query = search.value.trim().toLowerCase();
    let shown = 0;
    for (const item of items) {
      const visible = (!status || item.dataset.status === status) && (item.dataset.search ?? '').includes(query);
      item.hidden = !visible;
      if (visible) {
        shown++;
        item.classList.add('is-in');
      }
    }
    for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.status === status));
    empty.hidden = shown > 0;

    const next = new URLSearchParams();
    if (query) next.set('q', query);
    if (status) next.set('status', status);
    const qs = next.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  };

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      status = chip.dataset.status ?? '';
      update();
    });
  }
  search.addEventListener('input', update);
  if (search.value || status) update();
</script>

<style>
  .toolbar {
    display: grid;
    gap: 12px;
    margin-bottom: 24px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 14px;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px 20px;
    }
  }

  @media (min-width: 768px) {
    .toolbar {
      grid-template-columns: 300px 1fr;
      align-items: center;
      gap: 16px;
      margin-bottom: 32px;
    }

    .chips {
      margin: 0;
      padding: 0;
    }
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 40px 24px;
    }
  }
</style>
