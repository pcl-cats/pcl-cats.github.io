---
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import CatAvatar from '../../components/CatAvatar.astro';
import DiaryRow from '../../components/DiaryRow.astro';
import Icon from '../../components/Icon.astro';
import { catArt, catFacts, getCats, getDiary, statusLabel, statusTone, type Cat } from '../../lib/content';

export async function getStaticPaths() {
  const cats = await getCats();
  return cats.map((cat) => ({ params: { id: cat.id }, props: { cat } }));
}

const { cat } = Astro.props as { cat: Cat };
const { Content } = await render(cat);
const { name, photo, status } = cat.data;

const cats = await getCats();
const family = (cat.data.relations ?? [])
  .map((relation) => ({ label: relation.label, cat: cats.find((item) => item.id === relation.cat) }))
  .filter((item): item is { label: string; cat: Cat } => item.cat !== undefined);
const diary = (await getDiary()).filter((entry) => entry.data.cats?.includes(cat.id));
const poses = catArt(cat.id);
const facts = catFacts(cat);
---

<SiteLayout title={name} description={`园区猫猫${name}的档案和日记。`} image={photo}>
  <div class="container">
    <a class="back" href="/cats/"><Icon name="arrow-left" size={18} /> 园区的猫</a>
  </div>

  <article class="profile container">
    <div class="media">
      <div class="photo">
        <img src={photo} alt={name} width="800" height="1000" style={`view-transition-name: cat-${cat.id}`} />
      </div>
      {
        poses.length > 0 && (
          <button class="doodle" type="button" aria-label={`摸摸${name}`} data-pet data-meow data-poses={JSON.stringify(poses)}>
            <img src={poses[0]} alt="" width="200" height="200" />
          </button>
        )
      }
    </div>

    <div class="info">
      <div class="title">
        <h1>{name}</h1>
        <span class:list={['tag', `tag-${statusTone[status]}`]}>{statusLabel[status]}</span>
      </div>
      {facts.length > 0 && <ul class="facts">{facts.map((fact) => <li>{fact}</li>)}</ul>}
      <div class="story prose"><Content /></div>

      {
        family.length > 0 && (
          <section class="family" aria-labelledby="family-title">
            <h2 id="family-title">家人和伙伴</h2>
            <div class="family-list">
              {family.map((item) => <CatAvatar cat={item.cat} label={item.label} size={64} transition={false} />)}
            </div>
          </section>
        )
      }

      {
        diary.length > 0 && (
          <section class="diary" aria-labelledby="diary-title">
            <div class="section-head">
              <h2 id="diary-title">和{name}有关的日记</h2>
              {diary.length > 5 && (
                <a class="more-link" href={`/diary/?cat=${cat.id}`}>
                  全部 {diary.length} 篇 <Icon name="arrow-right" />
                </a>
              )}
            </div>
            <div class="rows">
              {diary.slice(0, 5).map((entry) => <DiaryRow entry={entry} sub="month" />)}
            </div>
          </section>
        )
      }
    </div>
  </article>

</SiteLayout>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 16px 0 12px;
    font-size: 15px;
    color: var(--text-soft);
  }

  .back:hover {
    color: var(--heading);
  }

  .profile {
    display: grid;
    gap: 28px;
  }

  .media {
    position: relative;
    align-self: start;
  }

  .photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-deep);
    box-shadow: var(--shadow);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .doodle {
    position: absolute;
    right: -6px;
    bottom: -26px;
    width: 34%;
    max-width: 170px;
    animation: say-hi 1.2s 1s var(--ease-out) both;
  }

  .doodle img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 6px 10px rgb(74 52 28 / 0.2));
  }

  @keyframes say-hi {
    0% {
      opacity: 0;
      transform: translateY(16px) scale(0.85);
    }
    55% {
      opacity: 1;
      transform: translateY(-4px) rotate(-4deg);
    }
    80% {
      transform: rotate(3deg);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  .title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 14px;
  }

  h1 {
    font-size: clamp(40px, 10vw, 60px);
    line-height: 1.15;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 15px;
    color: var(--text-soft);
  }

  .story {
    margin-top: 22px;
  }

  .family {
    margin-top: 36px;
  }

  .family h2 {
    font-size: 22px;
    margin-bottom: 14px;
  }

  .family-list {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 6px;
  }

  .diary {
    margin-top: 44px;
  }

  .diary h2 {
    font-size: 22px;
  }

  .rows > :global(* + *) {
    border-top: 1px solid var(--line);
  }

  @media (min-width: 720px) {
    .profile {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      gap: clamp(36px, 5vw, 64px);
      padding-top: 16px;
    }

    .media {
      position: sticky;
      top: 100px;
    }

    .doodle {
      right: -20px;
      bottom: -32px;
    }

    .info {
      padding-top: 12px;
    }
  }
</style>
