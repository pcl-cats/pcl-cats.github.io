---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const comics = (await getCollection('comics')).sort((a, b) => a.data.issue - b.data.issue);
---

<SiteLayout title="猫猫漫画"><section class="page-intro container"><p class="eyebrow">CAT COMICS / 猫猫漫画</p><h1>猫的日常，<br /><span>也可以画出来。</span></h1><p>来自原始记录的 8 期小漫画。</p></section><section class="container comic-archive comic-grid">{comics.map((comic) => <a href={`/comics/${String(comic.data.issue).padStart(2, '0')}/`}><div><img src={comic.data.images[0]} alt={`${comic.data.title}漫画封面`} loading="lazy" width="400" height="520" /></div><strong>{comic.data.title}</strong><span>{comic.data.cast}</span></a>)}</section></SiteLayout>
